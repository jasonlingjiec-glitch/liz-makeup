.hero{width:750rpx;height:880rpx;background:#F6F3EE;overflow:hidden}
.hero-img{width:100%;height:100%;display:block}

/* 自定义 tabBar 是浮在页面上的，底部留出它的高度 */
.page{padding-bottom:100rpx;padding-bottom:calc(100rpx + constant(safe-area-inset-bottom));padding-bottom:calc(100rpx + env(safe-area-inset-bottom))}

.intro{position:relative;padding-top:56rpx;padding-bottom:8rpx}
/* 右上角的语言切换键不占位：英文 eyebrow 长，右边留出切换键的位置 */
.lang-en .intro .eyebrow{padding-right:110rpx}
.hero-title{margin-top:24rpx}
.hero-title .line{display:block;font-size:104rpx;line-height:.98;letter-spacing:10rpx;font-weight:400}
.hero-sub{display:block;margin-top:28rpx;font-size:26rpx;letter-spacing:10rpx;color:var(--ink-2)}
.hero-desc{margin-top:40rpx}
.hero-desc .line{display:block}
.hero-actions{margin-top:44rpx}

.sec-top{display:flex;align-items:flex-end;justify-content:space-between;padding-bottom:44rpx}
.more{font-size:22rpx;letter-spacing:2rpx;color:var(--muted)}

/* 风格精选：一排横滑 */
.hscroll{
  width:100%;white-space:nowrap;
  padding-left:72rpx;
  box-sizing:border-box;
}
.hcard{
  display:inline-block;vertical-align:top;white-space:normal;
  width:440rpx;margin-right:24rpx;
}
.hcard-img{
  display:block;width:440rpx;height:550rpx;
  border-radius:var(--radius);background:var(--wash);
}
.hcard-meta{padding-top:18rpx;margin-top:18rpx;border-top:1rpx solid var(--line)}
.hcard-name{display:block;font-size:28rpx;letter-spacing:2rpx}
.hcard-en{display:block;margin-top:8rpx;font-size:18rpx;letter-spacing:4rpx;text-transform:uppercase;color:var(--muted)}
.hpad{display:inline-block;width:72rpx;height:1rpx}

.brands{display:flex;flex-wrap:wrap;margin-top:32rpx;border-top:1rpx solid var(--line)}
.brand{
  width:50%;padding:22rpx 0;font-size:22rpx;letter-spacing:2rpx;color:var(--ink-2);
  border-bottom:1rpx solid var(--line);
}

.cta-desc{margin-top:20rpx;margin-bottom:40rpx}
