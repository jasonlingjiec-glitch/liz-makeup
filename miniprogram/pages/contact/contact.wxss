/* 自定义 tabBar 是浮在页面上的，底部留出它的高度 */
.page{padding-bottom:100rpx;padding-bottom:calc(100rpx + constant(safe-area-inset-bottom));padding-bottom:calc(100rpx + env(safe-area-inset-bottom))}

.head{position:relative;padding-top:56rpx;padding-bottom:48rpx}
.head-lead{margin-top:28rpx}

.steps{border-top:1rpx solid var(--line)}
.step{display:flex;align-items:flex-start;padding:32rpx 0;border-bottom:1rpx solid var(--line)}
.step-n{flex:0 0 62rpx;font-size:20rpx;letter-spacing:2rpx;color:var(--muted);padding-top:4rpx}
.step-body{flex:1}
.step-t{display:block;font-size:29rpx;letter-spacing:3rpx}
.step-d{display:block;margin-top:12rpx;font-size:23rpx;line-height:1.9;color:var(--body)}

.card{margin-top:56rpx}
.card-inner{
  display:flex;align-items:center;gap:36rpx;
  padding:40rpx 36rpx;border:1rpx solid var(--line);
}
.qr{width:300rpx;height:300rpx;flex:0 0 300rpx;border-radius:16rpx}
.card-info{flex:1;min-width:0}
.card-k{display:block;font-size:18rpx;letter-spacing:5rpx;text-transform:uppercase;color:var(--muted)}
.card-id{display:block;margin-top:14rpx;font-size:40rpx;letter-spacing:3rpx;line-height:1.2}
.copy{
  display:inline-block;margin-top:26rpx;padding:13rpx 22rpx;
  border:1rpx solid var(--line);font-size:18rpx;letter-spacing:2rpx;color:var(--body);
  white-space:nowrap;max-width:100%;
}
.card-note{display:block;margin-top:26rpx;font-size:20rpx;letter-spacing:2rpx;color:var(--muted)}
.hint{padding-top:28rpx;font-size:20rpx;letter-spacing:2rpx;color:var(--muted)}
