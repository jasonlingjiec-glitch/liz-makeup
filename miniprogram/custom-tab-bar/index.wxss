/* 自定义 tabBar：外观对齐原来的原生 tabBar —— 白底、顶部 1rpx 细线、四个纯文字标签 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  height: 100rpx;
  box-sizing: content-box;
  background: #FFFFFF;
  border-top: 1rpx solid #E4DED4;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.tabbar-item {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tabbar-label {
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #8B8279;
}

.tabbar-item.on .tabbar-label {
  color: #14110E;
}
