page{
  --ink:#14110E;
  --ink-2:#2A2622;
  --body:#4A443D;
  --muted:#8B8279;
  --line:#E4DED4;
  --wash:#F6F3EE;
  --radius:24rpx;
  background:#ffffff;
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB",sans-serif;
  font-size:26rpx;
  line-height:1.7;
  -webkit-font-smoothing:antialiased;
}

view,text,image{box-sizing:border-box}
.wrap{padding-left:72rpx;padding-right:72rpx}

.eyebrow{
  display:block;
  font-size:20rpx;letter-spacing:8rpx;text-transform:uppercase;
  color:var(--muted);line-height:1.5;
}
.lead{font-size:26rpx;line-height:2;color:var(--body)}
.h1{font-size:72rpx;line-height:1.06;letter-spacing:8rpx;font-weight:400}
.h2{font-size:52rpx;line-height:1.26;letter-spacing:6rpx;font-weight:400}
.title-wrap{margin-top:20rpx}

.btn{
  display:flex;align-items:center;justify-content:center;
  height:96rpx;padding:0 44rpx;
  font-size:24rpx;letter-spacing:4rpx;white-space:nowrap;
  border:1rpx solid var(--ink);
}
.btn-solid{background:var(--ink);color:#fff}
.btn-ghost{background:transparent;color:var(--ink)}
.btn-block{display:flex;width:100%}
.btn-row{display:flex;gap:20rpx}

.sec{padding-top:96rpx;padding-bottom:96rpx}
.sec-wash{background:var(--wash)}
.sec-head{padding-bottom:44rpx}
.sec-title{margin-top:18rpx}
.rule{height:1rpx;background:var(--line)}

.foot{
  padding:72rpx 72rpx 60rpx;
  border-top:1rpx solid var(--line);
}
.foot-en{font-size:30rpx;letter-spacing:10rpx}
.foot-cn{display:block;margin-top:18rpx;font-size:20rpx;letter-spacing:4rpx;color:var(--muted)}

/* 语言切换键：不占位，绝对定位到页面头部右上角（各页 .head / 首页 .intro 需 position:relative） */
.lang-switch{
  position:absolute;
  top:24rpx;
  right:72rpx;
  z-index:2;
  min-width:88rpx;
  height:88rpx;
  display:flex;
  align-items:center;
  justify-content:flex-end;
  font-size:20rpx;
  line-height:1;
  letter-spacing:4rpx;
  color:var(--muted);
}
.lang-switch text{line-height:1}
